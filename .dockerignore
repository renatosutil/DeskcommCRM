# Reduz o contexto de build e — crítico — mantém segredos fora da imagem.
# Sem isto o `next build` carregaria .env.local e embutiria/vazaria segredos.
node_modules
.next
.git
.env
.env.*
test-results
tests
playwright.config.ts
*.png
*.log
.lina
docs
tasks
scratchpad
.vercel
# Harness de sessão de IA (skills, hooks, config de CLI): não é código de
# runtime e entrava inteiro na imagem do worker (`COPY . .`).
.claude
.agents
.agent
.codex
.cursor
.opencode
.specs
.changes

# Artefatos locais de QA não fazem parte do runtime.
evidence
.superpowers
*.tsbuildinfo

# Testes Python do coletor são montados somente no runner de testes.
integracoes/rb-atacado/coletor/test-*.py
scripts/rb-verificar-ci.test.py
